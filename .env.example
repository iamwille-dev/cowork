# Set in the Encore backend environment.
DATABASE_URL=postgres://cowork:cowork@127.0.0.1:5432/cowork?sslmode=disable
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
COWORK_PUBLIC_URL=
# Use a PostgreSQL schema and absolute writable state directory for a fresh Cowork deployment.
COWORK_DATABASE_SCHEMA=
COWORK_STATE_DIR=
# Enable Clerk after configuring the Cowork origin and the Clerk instance.
COWORK_AUTH=
COWORK_CLERK_ISSUER=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Agent Connections shares DATABASE_URL unless a separate database is configured.
AGENT_CONNECTIONS_ENABLED=
AGENT_CONNECTIONS_DATABASE_URL=
AGENT_CONNECTIONS_MCP_URL=
LOCAL_ENCRYPTION_KEY=
CLERK_ISSUER=
TESTER_SUBJECTS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
MCP_RESOURCE_URL=
AWS_SES_REGION=
AWS_SES_FROM_EMAIL=
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
AGENT_CONNECTION_WORKSPACE_ID=
AGENT_CONNECTION_KEY=
# Set on the Encore backend before the first save or migration.
AGENT_CONNECTION_ENCRYPTION_KEY=
# Set the same internal Telegram bridge secret on the Mastra worker and Encore.
COWORK_TELEGRAM_BRIDGE_SECRET=
# Cowork-owned distributed Slack app (Mastra worker). COWORK_PUBLIC_URL must be public HTTPS.
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Enable after the Slack apps are configured for chat:write.customize.
COWORK_SLACK_CUSTOM_NAMES=
# Set the same encryption key on the Mastra worker and Encore for Slack tools.
MASTRA_ENCRYPTION_KEY=

# Separate distributed Slack app credentials for each named agent.
SLACK_ADA_APP_ID=
SLACK_ADA_CLIENT_ID=
SLACK_ADA_CLIENT_SECRET=
SLACK_ADA_SIGNING_SECRET=
SLACK_SAM_APP_ID=
SLACK_SAM_CLIENT_ID=
SLACK_SAM_CLIENT_SECRET=
SLACK_SAM_SIGNING_SECRET=
